{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/assets/**/*.ts",
    "src/assets/**/*.tsx",
    "src/assets/game/src",
    "src/assets/game/src/**"
  ]
}
