{
  "name": "ethernia-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty false",
    "start:clear": "expo start --clear",
    "android:clear": "expo start --android --clear",
    "install:expo-deps": "npx expo install lottie-react-native react-native-reanimated",
    "doctor": "npx expo-doctor",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "submit:android": "npx eas-cli submit --platform android",
    "reset:windows": "powershell -ExecutionPolicy Bypass -File ./RESET_WINDOWS_INSTALL.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.11",
    "expo-splash-screen": "56.0.10",
    "expo-status-bar": "56.0.4",
    "lottie-react-native": "7.3.8",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-preset-expo": "^56.0.15",
    "typescript": "6.0.3"
  }
}
